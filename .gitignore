# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/*
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project specific
*.pdf
!document/*.pdf
output/

# PyInstaller build output
dist/PDF_Editor/
dist_tmp/
*.manifest
!core/native/QuickMarkPDF.manifest

# Keep the distribution documentation and empty asset folders tracked.
!dist/documents/
!dist/documents/*
!dist/assets/
!dist/assets/.gitkeep

# AI tools and local notes
CODEX_PROJECT_NOTE.txt
.claude/

# core/native: build_native.py が生成する中間ファイル
core/native/*.dll
core/native/*.o
core/native/*.exe

# dist/binary: ビルド成果物はGit管理外、フォルダ構造だけ管理
dist/binary/*
!dist/binary/.gitkeep

# Downloaded SDKs
third_party/webview2/
third_party/pdfium/
third_party/*.nupkg
third_party/*.tgz

# Build logs
*.log

# Test tooling: generated reports/caches are not tracked.
# tests/visual_baselines/ (the actual reference screenshots) IS tracked.
python/tests/reports/
.pytest_cache/
.coverage
htmlcov/
